<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav>
        <ul>
            {% for page in collections.navigation | sort(false, false, "data.navOrder") %}
                <li>
                    <a href="{{ page.url }}">{{ page.data.navLabel }}</a>
                </li>
            {% endfor %}
        </ul>
    </nav>

    <main>
        <h1>{{ title }}</h1>

        {% for service in services %}
            <article class="service">
                <h2>{{ service.title }}</h2>
                <p>{{ service.description }}</p>
            </article>
        {% endfor %}
    </main>

</body>
</html>